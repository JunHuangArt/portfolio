---
// Development previews do not load analytics.
const enabled = import.meta.env.PROD;
---
{enabled && <script is:inline>
  (() => {
    if (!['www.junhuang.art', 'junhuang.art'].includes(window.location.hostname)) return;
    if (window.__junHuangAnalyticsLoaded) return;
    window.__junHuangAnalyticsLoaded = true;

    function loadAnalytics() {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'G-97X89CQS8D');

      const script = document.createElement('script');
      script.async = true;
      script.fetchPriority = 'low';
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-97X89CQS8D';
      document.head.appendChild(script);
    }

    function scheduleAnalytics() {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadAnalytics, { timeout: 3000 });
      } else {
        window.setTimeout(loadAnalytics, 1500);
      }
    }

    if (document.readyState === 'complete') scheduleAnalytics();
    else window.addEventListener('load', scheduleAnalytics, { once: true });
  })();
</script>}
